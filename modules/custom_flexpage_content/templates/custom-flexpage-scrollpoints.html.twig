<section class="visual-story visual-story--scrollpoints" data-vs-scrollpoints>
  <div class="visual-story__scrollpoints-media">
    <img src="{{ image_url }}" alt="{{ image_alt }}">
    {% for point in points %}
      <button
        class="visual-story__point"
        type="button"
        style="left: {{ point.x }}%; top: {{ point.y }}%;"
        data-vs-point="{{ loop.index0 }}"
        aria-label="Point {{ loop.index }}: {{ point.title }}">
        <span>{{ loop.index }}</span>
      </button>
    {% endfor %}
  </div>
  <div class="visual-story__scrollpoints-panel">
    {% if headline %}
      <h2 class="visual-story__headline">{{ headline }}</h2>
    {% endif %}
    {% if intro %}
      <p class="visual-story__intro">{{ intro }}</p>
    {% endif %}
    <ol class="visual-story__point-list">
      {% for point in points %}
        <li class="visual-story__point-panel" data-vs-panel="{{ loop.index0 }}">
          <h3>{{ point.title }}</h3>
          <p>{{ point.body|nl2br }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

