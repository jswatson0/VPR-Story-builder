<section class="visual-story visual-story--bg-video visual-story--height-{{ height }} visual-story--copy-{{ copy_theme }} visual-story--overlay-{{ overlay_strength }} visual-story--text-{{ text_position }}" data-vs-bg-video>
  <div class="visual-story__bg-video-wrap">
    {% if video_url %}
      <video class="visual-story__bg-video" autoplay muted loop playsinline{% if poster_url %} poster="{{ poster_url }}"{% endif %} aria-hidden="true">
        <source src="{{ video_url }}" type="{{ video_mime }}">
      </video>
    {% endif %}
    {% if poster_url and not video_url %}
      <img class="visual-story__bg-video-fallback" src="{{ poster_url }}" alt="{{ poster_alt }}" loading="lazy">
    {% endif %}
    <div class="visual-story__bg-video-overlay"></div>
  </div>
  {% if eyebrow or headline or dek or (cta_label and cta_url) %}
    <div class="visual-story__content">
      <div class="visual-story__content-inner">
        {% if eyebrow %}
          <p class="visual-story__eyebrow">{{ eyebrow }}</p>
        {% endif %}
        {% if headline %}
          <h2 class="visual-story__headline">{{ headline }}</h2>
        {% endif %}
        {% if dek %}
          <p class="visual-story__dek">{{ dek }}</p>
        {% endif %}
        {% if cta_label and cta_url %}
          <p class="visual-story__cta-wrap">
            <a class="visual-story__cta" href="{{ cta_url }}">{{ cta_label }}</a>
          </p>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>
