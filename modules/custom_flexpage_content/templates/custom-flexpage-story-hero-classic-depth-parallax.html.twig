<section class="visual-story visual-story--hero visual-story--hero-classic-depth visual-story--height-{{ height }} visual-story--align-{{ text_alignment }} visual-story--content-vpos-{{ content_vertical_position }} visual-story--copy-{{ copy_theme }} visual-story--overlay-{{ overlay_strength }}" data-vs-classic-depth-hero data-vs-foreground-behavior="{{ foreground_behavior }}" data-vs-foreground-pin-vh="{{ foreground_pin_vh }}" data-vs-text-zoom-effect="{{ text_zoom_effect }}" style="--vs-bg-focal-x: {{ focal_x }}%; --vs-bg-focal-y: {{ focal_y }}%; --vs-bg-scale: {{ background_zoom }};">
  <div class="visual-story__bg-layer">
    <img class="visual-story__bg-image" src="{{ background_url }}" alt="{{ background_alt }}" data-vs-classic-bg>
    <div class="visual-story__overlay"></div>
    <div class="visual-story__vignette"></div>
  </div>
  <div class="visual-story__content" data-vs-classic-content>
    {% if eyebrow %}
      <p class="visual-story__eyebrow">{{ eyebrow }}</p>
    {% endif %}
    {% if headline %}
      <h2 class="visual-story__headline">{{ headline }}</h2>
    {% endif %}
    {% if dek %}
      <p class="visual-story__dek">{{ dek }}</p>
    {% endif %}
    {% if cta_label and cta_url %}
      <p class="visual-story__cta-wrap">
        <a class="visual-story__cta" href="{{ cta_url }}">{{ cta_label }}</a>
      </p>
    {% endif %}
  </div>
</section>
