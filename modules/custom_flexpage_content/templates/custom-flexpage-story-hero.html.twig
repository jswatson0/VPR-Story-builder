<section class="visual-story visual-story--hero visual-story--height-{{ height }} visual-story--align-{{ text_alignment }} visual-story--overlay-{{ overlay_strength }}">
  <img class="visual-story__bg-image" src="{{ background_url }}" alt="{{ background_alt }}">
  <div class="visual-story__overlay"></div>
  <div class="visual-story__content container">
    {% if eyebrow %}
      <p class="visual-story__eyebrow">{{ eyebrow }}</p>
    {% endif %}
    {% if headline %}
      <h2 class="visual-story__headline">{{ headline }}</h2>
    {% endif %}
    {% if dek %}
      <p class="visual-story__dek">{{ dek }}</p>
    {% endif %}
    {% if cta_label and cta_url %}
      <p class="visual-story__cta-wrap">
        <a class="visual-story__cta" href="{{ cta_url }}">{{ cta_label }}</a>
      </p>
    {% endif %}
  </div>
</section>

