/**
 * @file
 * Theme hooks for custom flexpage storytelling blocks.
 */

/**
 * Implements hook_theme().
 */
function custom_flexpage_content_theme($existing, $type, $theme, $path) {
  return [
    'custom_flexpage_story_hero_classic_depth_parallax' => [
      'variables' => [
        'eyebrow' => '',
        'headline' => '',
