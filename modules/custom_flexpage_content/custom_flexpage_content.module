        'cta_url' => '',
        'background_url' => '',
        'background_alt' => '',
        'height' => 'tall',
        'text_alignment' => 'left',
        'content_vertical_position' => 'middle',
        'copy_theme' => 'light',
        'overlay_strength' => 'medium',
        'midground_strength' => 'medium',
        'foreground_behavior' => 'pinned_then_release',
        'foreground_pin_vh' => '70',
        'focal_x' => '50',
        'focal_y' => '32',
        'background_zoom' => '1.06',
      ],
      'template' => 'custom-flexpage-story-hero-classic-depth-parallax',
    ],
    'custom_flexpage_text_over_media' => [
      'variables' => [
        'headline' => '',
        'body' => '',
        'media_url' => '',
        'media_alt' => '',
        'layout' => 'media-right',
        'color_theme' => 'dark',
      ],
      'template' => 'custom-flexpage-text-over-media',
    ],
    'custom_flexpage_scrollpoints' => [
      'variables' => [
        'headline' => '',
        'intro' => '',
        'image_url' => '',
        'image_alt' => '',
        'points' => [],
      ],
      'template' => 'custom-flexpage-scrollpoints',
    ],
    'research_image_grid_block' => [
      'variables' => [
        'items' => [],
        'modal_title_default' => '',
        'images_per_row' => 3,
      ],
      'template' => 'research-image-grid-block',
    ],
  ];
}
